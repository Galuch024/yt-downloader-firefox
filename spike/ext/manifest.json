{
  "manifest_version": 2,
  "name": "YT Downloader - prototyp etapu 0",
  "version": "0.0.1",
  "browser_specific_settings": {
    "gecko": { "id": "ytdl-spike@local.test", "strict_min_version": "128.0" }
  },
  "permissions": [
    "downloads", "tabs", "cookies",
    "*://*.youtube.com/*", "*://*.googlevideo.com/*", "*://*.googleapis.com/*", "*://*.ytimg.com/*"
  ],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [{
    "matches": ["*://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": ["page.js"],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval' blob:; object-src 'self'; worker-src 'self' blob:"
}
